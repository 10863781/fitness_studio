# Copy this file to .env and fill in real values. .env is ignored by git.

# Postgres connection string from Neon (Dashboard -> Connect)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Long random string used to sign login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=change-me

# Public URL of the site the browser loads (Vite dev server locally, Vercel when live)
BETTER_AUTH_URL=http://localhost:5173

PORT=3000
